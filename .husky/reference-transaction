#!/usr/bin/env bash
# Prevent a ref transaction from making local commits unreachable.
#
# This hook is deliberately preventive and read-only. It does not stash,
# snapshot, create rescue refs, reconcile state, or repair an operation after
# the fact. The working-tree root control is one isolated worktree per agent;
# this hook is the final fail-closed boundary for committed work.
#
# stdin: <old-object> SP <new-object> SP <ref-name> LF
set -u

[ "${1:-}" = "prepared" ] || exit 0

ZERO=0000000000000000000000000000000000000000

while read -r OLD NEW REF; do
  case "$REF" in
    HEAD|refs/heads/main|refs/heads/master) ;;
    *) continue ;;
  esac

  [ "$OLD" != "$ZERO" ] || continue
  [ "$OLD" != "$NEW" ] || continue

  if [ "$NEW" = "$ZERO" ]; then
    CANDIDATE=$(git rev-list --max-count=1 "$OLD" --not --exclude="$REF" --all 2>/dev/null || true)
    ORPHANED=$(git log --oneline --max-count=20 "$OLD" --not --exclude="$REF" --all 2>/dev/null || true)
  else
    CANDIDATE=$(git rev-list --max-count=1 "$OLD" --not "$NEW" --exclude="$REF" --all 2>/dev/null || true)
    ORPHANED=$(git log --oneline --max-count=20 "$OLD" --not "$NEW" --exclude="$REF" --all 2>/dev/null || true)
  fi
  [ -n "$CANDIDATE" ] || continue
  {
    echo
    echo "  BLOCKED: this ref update would make local commits unreachable."
    echo
    printf '%s\n' "$ORPHANED" | sed 's/^/    /'
    echo
    echo "  Create or push a branch that contains the commits, then retry."
    echo "  No hook-created snapshot or recovery ref was written."
    echo
  } >&2
  exit 1
done

exit 0
