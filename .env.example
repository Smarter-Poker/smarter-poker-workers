# smarter-poker-workers — .env template
# Copy to /opt/workers/.env on the Hetzner VM (owner workers:workers, mode 0600).
# NEVER commit the populated version.

# ─── Auth ────────────────────────────────────────────────────────────────────
# Must match World Hub's CRON_SECRET — Open Claw dispatcher signs requests with it.
CRON_SECRET=

# Comma-separated list of IPs allowed to call /cron/*. Openclaw dispatcher + local.
ALLOWED_CRON_IPS=178.104.160.250,127.0.0.1

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://kuklfnapbkmacvwxktbh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Observability ──────────────────────────────────────────────────────────
POSTHOG_API_KEY=

# ─── External integrations (only as needed per migrated cron) ───────────────
RESEND_API_KEY=
# Sender of the weekly fleet digest; blank means alerts@smarter.poker.
RESEND_FROM_EMAIL=
# Recipient(s) of the weekly fleet digest, comma separated; blank falls back to OPS_ALERT_EMAIL.
FLEET_DIGEST_EMAIL=
# The platform ops inbox (the same address World Hub probe and audit failures mail).
# The weekly fleet digest goes here when FLEET_DIGEST_EMAIL is blank; with both blank
# the Monday fire answers 503 recipient_unset and the cron log records an error.
OPS_ALERT_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8081

# ─── Trivia nightly tournament release controls (default off) ──────────────
TRIVIA_TOURNAMENTS_ENABLED=false
TRIVIA_TOURNAMENT_HORSES_ENABLED=false
