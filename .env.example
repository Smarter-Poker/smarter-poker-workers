# smarter-poker-workers — .env template
# Copy to /opt/workers/.env on the Hetzner VM (owner workers:workers, mode 0600).
# NEVER commit the populated version.

# ─── Auth ────────────────────────────────────────────────────────────────────
# Must match World Hub's CRON_SECRET — Open Claw dispatcher signs requests with it.
CRON_SECRET=

# Comma-separated list of IPs allowed to call /cron/*. Openclaw dispatcher + local.
ALLOWED_CRON_IPS=178.104.160.250,127.0.0.1

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://kuklfnapbkmacvwxktbh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_API_KEY=

# ─── Auth-health monitor (/cron/auth-health-monitor) ────────────────────────
# The JWKS drift check and the crypto.subtle import canary need NOTHING here —
# they run on plain fetch against the public JWKS endpoint.
#
# The five auth_logs checks (GoTrue fallback volume, signature errors, the
# signature-error source notice, refresh-token failures, credential stuffing)
# read Supabase log data, which is NOT reachable through the service-role
# PostgREST client. They need a Supabase personal access token with access to
# this project:
#   https://supabase.com/dashboard/account/tokens  →  "Generate new token"
# Leave it blank and those five checks report status 'skipped' instead of
# crashing the job.
SUPABASE_MANAGEMENT_API_TOKEN=

# Optional. Derived from NEXT_PUBLIC_SUPABASE_URL when unset.
SUPABASE_PROJECT_REF=
AUTH_MONITOR_JWKS_URL=

# Look-back window per run, minutes. Minimum 5. Default 60.
AUTH_MONITOR_WINDOW_MINUTES=60

# ─── Thresholds ─────────────────────────────────────────────────────────────
# Every default below is derived from the real 2026-09-01 auth_logs series.
# The full derivation lives in the header block of src/lib/authHealth.ts —
# read it before changing anything here.
#
# THE ONE THING TO KNOW: successful GoTrue /user calls per hour is the clean
# regression signal (purely our own traffic — it collapsed 20,752/h → 91/h the
# hour the ES256 fix landed). The raw count of "signing method HS256 is
# invalid" is NOT: it is dominated by external bots replaying forged tokens at
# /user, it never reaches zero, and alerting on it would page forever.

# PRIMARY SIGNAL. Successful (HTTP 200) /user calls per hour.
#   broken floor  17,028/h   healthy peak  2,704/h and still falling
# 8,000/h is 2.96× the healthy peak and 0.47× the broken floor.
AUTH_MONITOR_GOTRUE_USER_PER_HOUR=8000
# Early-warning tier, ~1.5× the healthy peak. Warns; does not page.
AUTH_MONITOR_GOTRUE_USER_WARN_PER_HOUR=4000
# Max share of all auth traffic that may be successful /user (ratio, 0–1).
# Measured: broken 0.737–0.764, healthy 0.198–0.513. (Was 0.30, which would
# have warned on perfectly healthy traffic.)
AUTH_MONITOR_GOTRUE_USER_RATIO=0.65
# Below this many total auth events the ratio is treated as noise.
AUTH_MONITOR_GOTRUE_MIN_SAMPLE=50

# Signature errors as a fraction of successful /user calls, evaluated ONLY when
# app-origin volume is already above the warn tier above. During the outage the
# ratio was 0.094–0.106. An absolute count cannot be used here — see the module
# header for why user_id and remote_addr filtering both fail on this stream.
AUTH_MONITOR_SIGNATURE_ERROR_APP_RATIO=0.02
# Informational only. Emit the `security` notice with the offending-IP list
# above this rate. Observed attack floor ~600–800/h, waves to 4,325/h.
# This never pages and never changes the health verdict.
AUTH_MONITOR_SIGNATURE_ERROR_NOTICE_PER_HOUR=500

# Refresh-token failures per hour (not-found + bad-length combined).
# Incident baseline ~210/h; confirmed at 0/h post-fix, so 100/h is defensible.
AUTH_MONITOR_REFRESH_FAILURES_PER_HOUR=100
# "Possible abuse attempt" on /token per hour. Incident wave was ~767/h.
# Note this counter does not see the HS256 replays — those hit /user.
AUTH_MONITOR_ABUSE_PER_HOUR=200

# ─── External integrations (only as needed per migrated cron) ───────────────
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Required for the SMS leg of scraperAlerts (and therefore for auth-health
# critical escalation). Without it, alerts still land in stdout + cron_health_log.
TWILIO_PHONE_NUMBER=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8081
